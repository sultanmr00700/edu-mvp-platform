# ===== Backend =====
# Postgres connection string (in docker-compose the host is "db", locally it's "localhost")
DATABASE_URL=postgresql://postgres:postgres@db:5432/edudb
# Local dev (no docker for the DB): DATABASE_URL=postgresql://postgres:postgres@localhost:5432/edudb

# Secret used to sign JWTs (mobile + web session cookies)
JWT_SECRET=your_strong_secret

# Redis (BullMQ job queue for the PDF worker)
REDIS_URL=redis://redis:6379

# API port + CORS origin of the frontend
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Local uploads folder (MVP) — later: Supabase Storage / S3
UPLOAD_DIR=uploads

# Set to "true" when serving over HTTPS
COOKIE_SECURE=false

# ===== Frontend =====
NEXT_PUBLIC_API_URL=http://localhost:4000
